NODE_ENV=development
HOST=127.0.0.1
PORT=3100

DATABASE_URL=mysql://用户名:密码@远程地址:3306/cat_robot?connection_limit=4&pool_timeout=15

JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=2h

CORS_ORIGIN=http://127.0.0.1:5602
CAT_ROBOT_PROJECT_ROOT=..
CONTENT_SNAPSHOT_TS_PATH=src/content/generated/contentSnapshot.ts
CONTENT_SNAPSHOT_JSON_PATH=content-store/published/content.snapshot.json

ART_UPLOAD_ROOT=content-store/art/uploads
ART_THUMBNAIL_ROOT=content-store/art/thumbnails
ART_STAGING_ROOT=content-store/art/staging
ART_RELEASE_ROOT=assets/art-releases
ART_MANIFEST_JSON_PATH=content-store/published/art-manifest.snapshot.json
ART_MANIFEST_TS_PATH=src/assets/generated/artManifestSnapshot.ts
ART_MAX_UPLOAD_MB=12
ART_MAX_PIXEL_COUNT=16777216
ART_THUMBNAIL_SIZE=256
